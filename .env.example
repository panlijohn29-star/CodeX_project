FLASK_SECRET_KEY=change-me

# Shared MySQL settings
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=600
DB_WRITE_TIMEOUT=600

# Per-database names used by the Closing Report feature
SCDBUS_DATABASE=scdbus
SCDBCA_DATABASE=scdbca

# Required only by ORD_DO_ALLOCATION: dedicated XC database connection.
XC_DB_HOST=your-xc-mysql-host
XC_DB_PORT=3306
XC_DB_USER=your-xc-user
XC_DB_PASSWORD=your-xc-password
XC_DB_NAME=your-xc-database

# Optional override
CLOSING_REPORT_MAX_WORKERS=4

# SQL Query discovers every configured *_DATABASE or *_DB profile above.
# The database account needs KILL QUERY permission to terminate long-running SQL.
